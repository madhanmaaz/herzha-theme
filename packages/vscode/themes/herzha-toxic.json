    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Foreground",
            "scope": [
                "entity.name.function.preprocessor"
            ],
            "settings": {
                "foreground": "#F0FFD9"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#CCFF5C"
            }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant",
                "constant.language"
            ],
            "settings": {
                "foreground": "#A8FF00"
            }
        },
        {
            "name": "Comment",
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#667253"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#7DFF5C"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "storage.type.enum",
                "storage.type.struct",
                "storage.type.template"
            ],
            "settings": {
                "foreground": "#CCFF5C"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#A8FF00"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "entity.name.function.operator"
            ],
            "settings": {
                "foreground": "#FF315B"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.constant.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#00E5FF"
            }
        },
        {
            "name": "Selector",
            "scope": [
                "entity.other.attribute-name.class.css"
            ],
            "settings": {
                "foreground": "#CCFF5C"
            }
        },
        {
            "name": "SelectorId",
            "scope": [
                "entity.other.attribute-name.id.css"
            ],
            "settings": {
                "foreground": "#A8FF00"
            }
        },
        {
            "name": "SelectorPseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-element"
            ],
            "settings": {
                "foreground": "#A8FF00"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#5CFF00"
            }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#A8FF00"
            }
        },
        {
            "name": "String Regex",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#9AFF66"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#FF315B"
            }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class",
                "storage.type.built-in.primitive",
                "support.type"
            ],
            "settings": {
                "foreground": "#00FF9D"
            }
        },
        {
            "name": "Namespace",
            "scope": [
                "entity.name.scope-resolution"
            ],
            "settings": {
                "foreground": "#5CFFBD"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.parameter.function-call"
            ],
            "settings": {
                "foreground": "#F0FFD9"
            }
        },
        {
            "name": "Variable Special",
            "scope": [
                "variable.language",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "foreground": "#FF315B"
            }
        },
        {
            "name": "Variable Parameter & Arguments",
            "scope": [
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#F0FFD9"
            }
        },
        {
            "name": "Text Literal",
            "scope": [
                "text.html.markdown markup.inline.raw"
            ],
            "settings": {
                "foreground": "#A7C38A"
            }
        },
        {
            "name": "Emphasis",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#CCFF5C"
            }
        },
        {
            "name": "Emphasis Strong",
            "scope": [
                "punctuation.definition.bold"
            ],
            "settings": {
                "foreground": "#A8FF00"
            }
        },
        {
            "name": "Link Text",
            "scope": [
                "string.other.link.title",
                "punctuation.definition.link.title",
                "string.other.link.description",
                "punctuation.definition.link.description"
            ],
            "settings": {
                "foreground": "#A8FF00"
            }
        },
        {
            "name": "Link Uri",
            "scope": [
                "markup.underline.link",
                "punctuation.definition.metadata"
            ],
            "settings": {
                "foreground": "#00E5FF"
            }
        },
        {
            "name": "Title",
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "foreground": "#5CFFBD"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.markdown",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section",
                "punctuation.accessor",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag",
                "meta.decorator punctuation.decorator",
                "markup.list punctuation.definition.list.begin"
            ],
            "settings": {
                "foreground": "#deffa3"
            }
        },
        {
            "name": "Punctuation Special",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": {
                "foreground": "#5CEFFF"
            }
        }
    ]
}