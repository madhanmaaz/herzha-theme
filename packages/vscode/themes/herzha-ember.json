    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Foreground",
            "scope": [
                "entity.name.function.preprocessor"
            ],
            "settings": {
                "foreground": "#E6DCD8"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#FFA88A"
            }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant",
                "constant.language"
            ],
            "settings": {
                "foreground": "#FF8F6B"
            }
        },
        {
            "name": "Comment",
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#6c615d"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#F0856C"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "storage.type.enum",
                "storage.type.struct",
                "storage.type.template"
            ],
            "settings": {
                "foreground": "#FFA88A"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#FF8F6B"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "entity.name.function.operator"
            ],
            "settings": {
                "foreground": "#FF6B6B"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.constant.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#D9A066"
            }
        },
        {
            "name": "Selector",
            "scope": [
                "entity.other.attribute-name.class.css"
            ],
            "settings": {
                "foreground": "#FFA88A"
            }
        },
        {
            "name": "SelectorId",
            "scope": [
                "entity.other.attribute-name.id.css"
            ],
            "settings": {
                "foreground": "#FF8F6B"
            }
        },
        {
            "name": "SelectorPseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-element"
            ],
            "settings": {
                "foreground": "#FF8F6B"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#A3C15A"
            }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#FF8F6B"
            }
        },
        {
            "name": "String Regex",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#BFDA84"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#FF6B6B"
            }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class",
                "storage.type.built-in.primitive",
                "support.type"
            ],
            "settings": {
                "foreground": "#F2B705"
            }
        },
        {
            "name": "Namespace",
            "scope": [
                "entity.name.scope-resolution"
            ],
            "settings": {
                "foreground": "#FFD166"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.parameter.function-call"
            ],
            "settings": {
                "foreground": "#E6DCD8"
            }
        },
        {
            "name": "Variable Special",
            "scope": [
                "variable.language",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "foreground": "#FF6B6B"
            }
        },
        {
            "name": "Variable Parameter & Arguments",
            "scope": [
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#E6DCD8"
            }
        },
        {
            "name": "Text Literal",
            "scope": [
                "text.html.markdown markup.inline.raw"
            ],
            "settings": {
                "foreground": "#B8AFAA"
            }
        },
        {
            "name": "Emphasis",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#FFA88A"
            }
        },
        {
            "name": "Emphasis Strong",
            "scope": [
                "punctuation.definition.bold"
            ],
            "settings": {
                "foreground": "#FF8F6B"
            }
        },
        {
            "name": "Link Text",
            "scope": [
                "string.other.link.title",
                "punctuation.definition.link.title",
                "string.other.link.description",
                "punctuation.definition.link.description"
            ],
            "settings": {
                "foreground": "#FF8F6B"
            }
        },
        {
            "name": "Link Uri",
            "scope": [
                "markup.underline.link",
                "punctuation.definition.metadata"
            ],
            "settings": {
                "foreground": "#D9A066"
            }
        },
        {
            "name": "Title",
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "foreground": "#FFD166"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.markdown",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section",
                "punctuation.accessor",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag",
                "meta.decorator punctuation.decorator",
                "markup.list punctuation.definition.list.begin"
            ],
            "settings": {
                "foreground": "#ecc9bd"
            }
        },
        {
            "name": "Punctuation Special",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": {
                "foreground": "#E8BB8C"
            }
        }
    ]
}