    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Foreground",
            "scope": [
                "entity.name.function.preprocessor"
            ],
            "settings": {
                "foreground": "#BBC3F0"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#B69BFF"
            }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant",
                "constant.language"
            ],
            "settings": {
                "foreground": "#9D7DFF"
            }
        },
        {
            "name": "Comment",
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#545671"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#879CFF"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "storage.type.enum",
                "storage.type.struct",
                "storage.type.template"
            ],
            "settings": {
                "foreground": "#B69BFF"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#9D7DFF"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "entity.name.function.operator"
            ],
            "settings": {
                "foreground": "#FB7F9C"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.constant.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#7ACBFF"
            }
        },
        {
            "name": "Selector",
            "scope": [
                "entity.other.attribute-name.class.css"
            ],
            "settings": {
                "foreground": "#B69BFF"
            }
        },
        {
            "name": "SelectorId",
            "scope": [
                "entity.other.attribute-name.id.css"
            ],
            "settings": {
                "foreground": "#9D7DFF"
            }
        },
        {
            "name": "SelectorPseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-element"
            ],
            "settings": {
                "foreground": "#9D7DFF"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#73D3AE"
            }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#9D7DFF"
            }
        },
        {
            "name": "String Regex",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#8AE1C3"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#FB7F9C"
            }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class",
                "storage.type.built-in.primitive",
                "support.type"
            ],
            "settings": {
                "foreground": "#55D0E0"
            }
        },
        {
            "name": "Namespace",
            "scope": [
                "entity.name.scope-resolution"
            ],
            "settings": {
                "foreground": "#75DDEB"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.parameter.function-call"
            ],
            "settings": {
                "foreground": "#BBC3F0"
            }
        },
        {
            "name": "Variable Special",
            "scope": [
                "variable.language",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "foreground": "#FB7F9C"
            }
        },
        {
            "name": "Variable Parameter & Arguments",
            "scope": [
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#BBC3F0"
            }
        },
        {
            "name": "Text Literal",
            "scope": [
                "text.html.markdown markup.inline.raw"
            ],
            "settings": {
                "foreground": "#8A91C4"
            }
        },
        {
            "name": "Emphasis",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#B69BFF"
            }
        },
        {
            "name": "Emphasis Strong",
            "scope": [
                "punctuation.definition.bold"
            ],
            "settings": {
                "foreground": "#9D7DFF"
            }
        },
        {
            "name": "Link Text",
            "scope": [
                "string.other.link.title",
                "punctuation.definition.link.title",
                "string.other.link.description",
                "punctuation.definition.link.description"
            ],
            "settings": {
                "foreground": "#9D7DFF"
            }
        },
        {
            "name": "Link Uri",
            "scope": [
                "markup.underline.link",
                "punctuation.definition.metadata"
            ],
            "settings": {
                "foreground": "#7ACBFF"
            }
        },
        {
            "name": "Title",
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "foreground": "#75DDEB"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.markdown",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section",
                "punctuation.accessor",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag",
                "meta.decorator punctuation.decorator",
                "markup.list punctuation.definition.list.begin"
            ],
            "settings": {
                "foreground": "#b4b2f4"
            }
        },
        {
            "name": "Punctuation Special",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": {
                "foreground": "#8FD7FF"
            }
        }
    ]
}