    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Foreground",
            "scope": [
                "entity.name.function.preprocessor"
            ],
            "settings": {
                "foreground": "#F4E9F8"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#FF9AD8"
            }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant",
                "constant.language"
            ],
            "settings": {
                "foreground": "#FF79C6"
            }
        },
        {
            "name": "Comment",
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#716471"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#D2B2FF"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "storage.type.enum",
                "storage.type.struct",
                "storage.type.template"
            ],
            "settings": {
                "foreground": "#FF9AD8"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#FF79C6"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "entity.name.function.operator"
            ],
            "settings": {
                "foreground": "#FF5555"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.constant.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#8BE9FD"
            }
        },
        {
            "name": "Selector",
            "scope": [
                "entity.other.attribute-name.class.css"
            ],
            "settings": {
                "foreground": "#FF9AD8"
            }
        },
        {
            "name": "SelectorId",
            "scope": [
                "entity.other.attribute-name.id.css"
            ],
            "settings": {
                "foreground": "#FF79C6"
            }
        },
        {
            "name": "SelectorPseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-element"
            ],
            "settings": {
                "foreground": "#FF79C6"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#7AF1C0"
            }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#FF79C6"
            }
        },
        {
            "name": "String Regex",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#96FFD4"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#FF5555"
            }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class",
                "storage.type.built-in.primitive",
                "support.type"
            ],
            "settings": {
                "foreground": "#FFB86C"
            }
        },
        {
            "name": "Namespace",
            "scope": [
                "entity.name.scope-resolution"
            ],
            "settings": {
                "foreground": "#FFD19A"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.parameter.function-call"
            ],
            "settings": {
                "foreground": "#F4E9F8"
            }
        },
        {
            "name": "Variable Special",
            "scope": [
                "variable.language",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "foreground": "#FF5555"
            }
        },
        {
            "name": "Variable Parameter & Arguments",
            "scope": [
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#F4E9F8"
            }
        },
        {
            "name": "Text Literal",
            "scope": [
                "text.html.markdown markup.inline.raw"
            ],
            "settings": {
                "foreground": "#BFA9CC"
            }
        },
        {
            "name": "Emphasis",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#FF9AD8"
            }
        },
        {
            "name": "Emphasis Strong",
            "scope": [
                "punctuation.definition.bold"
            ],
            "settings": {
                "foreground": "#FF79C6"
            }
        },
        {
            "name": "Link Text",
            "scope": [
                "string.other.link.title",
                "punctuation.definition.link.title",
                "string.other.link.description",
                "punctuation.definition.link.description"
            ],
            "settings": {
                "foreground": "#FF79C6"
            }
        },
        {
            "name": "Link Uri",
            "scope": [
                "markup.underline.link",
                "punctuation.definition.metadata"
            ],
            "settings": {
                "foreground": "#8BE9FD"
            }
        },
        {
            "name": "Title",
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "foreground": "#FFD19A"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.markdown",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section",
                "punctuation.accessor",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag",
                "meta.decorator punctuation.decorator",
                "markup.list punctuation.definition.list.begin"
            ],
            "settings": {
                "foreground": "#f7cdec"
            }
        },
        {
            "name": "Punctuation Special",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": {
                "foreground": "#A4F0FF"
            }
        }
    ]
}