    "semanticHighlighting": true,
    "tokenColors": [
        {
            "name": "Foreground",
            "scope": [
                "entity.name.function.preprocessor"
            ],
            "settings": {
                "foreground": "#E4FFFF"
            }
        },
        {
            "name": "Attribute",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#5CFAFF"
            }
        },
        {
            "name": "Boolean",
            "scope": [
                "constant",
                "constant.language"
            ],
            "settings": {
                "foreground": "#00F5FF"
            }
        },
        {
            "name": "Comment",
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#597175"
            }
        },
        {
            "name": "Function",
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#A06CFF"
            }
        },
        {
            "name": "Keyword",
            "scope": [
                "keyword",
                "storage.type",
                "storage.modifier",
                "storage.type.enum",
                "storage.type.struct",
                "storage.type.template"
            ],
            "settings": {
                "foreground": "#5CFAFF"
            }
        },
        {
            "name": "Number",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#00F5FF"
            }
        },
        {
            "name": "Operator",
            "scope": [
                "keyword.operator",
                "entity.name.function.operator"
            ],
            "settings": {
                "foreground": "#FF2868"
            }
        },
        {
            "name": "Property",
            "scope": [
                "variable.other.property",
                "variable.other.constant.property",
                "support.type.property-name"
            ],
            "settings": {
                "foreground": "#00BFFF"
            }
        },
        {
            "name": "Selector",
            "scope": [
                "entity.other.attribute-name.class.css"
            ],
            "settings": {
                "foreground": "#5CFAFF"
            }
        },
        {
            "name": "SelectorId",
            "scope": [
                "entity.other.attribute-name.id.css"
            ],
            "settings": {
                "foreground": "#00F5FF"
            }
        },
        {
            "name": "SelectorPseudo",
            "scope": [
                "entity.other.attribute-name.pseudo-element"
            ],
            "settings": {
                "foreground": "#00F5FF"
            }
        },
        {
            "name": "String",
            "scope": [
                "string",
                "constant.other.symbol"
            ],
            "settings": {
                "foreground": "#00FF85"
            }
        },
        {
            "name": "String Escape",
            "scope": [
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#00F5FF"
            }
        },
        {
            "name": "String Regex",
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#5CFFA9"
            }
        },
        {
            "name": "Tag",
            "scope": [
                "entity.name.tag",
                "meta.tag.sgml"
            ],
            "settings": {
                "foreground": "#FF2868"
            }
        },
        {
            "name": "Type",
            "scope": [
                "entity.name.class",
                "entity.name.module",
                "entity.name.type",
                "storage.identifier",
                "support.class",
                "storage.type.built-in.primitive",
                "support.type"
            ],
            "settings": {
                "foreground": "#00FF9C"
            }
        },
        {
            "name": "Namespace",
            "scope": [
                "entity.name.scope-resolution"
            ],
            "settings": {
                "foreground": "#5CFFBD"
            }
        },
        {
            "name": "Variable",
            "scope": [
                "variable",
                "variable.parameter.function-call"
            ],
            "settings": {
                "foreground": "#E4FFFF"
            }
        },
        {
            "name": "Variable Special",
            "scope": [
                "variable.language",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "foreground": "#FF2868"
            }
        },
        {
            "name": "Variable Parameter & Arguments",
            "scope": [
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#E4FFFF"
            }
        },
        {
            "name": "Text Literal",
            "scope": [
                "text.html.markdown markup.inline.raw"
            ],
            "settings": {
                "foreground": "#8FB8C2"
            }
        },
        {
            "name": "Emphasis",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#5CFAFF"
            }
        },
        {
            "name": "Emphasis Strong",
            "scope": [
                "punctuation.definition.bold"
            ],
            "settings": {
                "foreground": "#00F5FF"
            }
        },
        {
            "name": "Link Text",
            "scope": [
                "string.other.link.title",
                "punctuation.definition.link.title",
                "string.other.link.description",
                "punctuation.definition.link.description"
            ],
            "settings": {
                "foreground": "#00F5FF"
            }
        },
        {
            "name": "Link Uri",
            "scope": [
                "markup.underline.link",
                "punctuation.definition.metadata"
            ],
            "settings": {
                "foreground": "#00BFFF"
            }
        },
        {
            "name": "Title",
            "scope": [
                "markup.heading"
            ],
            "settings": {
                "foreground": "#5CFFBD"
            }
        },
        {
            "name": "Punctuation",
            "scope": [
                "punctuation.definition.markdown",
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.section",
                "punctuation.accessor",
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.tag.end",
                "punctuation.definition.tag.begin",
                "punctuation.definition.tag",
                "meta.decorator punctuation.decorator",
                "markup.list punctuation.definition.list.begin"
            ],
            "settings": {
                "foreground": "#abfdff"
            }
        },
        {
            "name": "Punctuation Special",
            "scope": [
                "punctuation.definition.template-expression",
                "punctuation.section.embedded",
                "punctuation.definition.template-expression.begin.js",
                "punctuation.definition.template-expression.end.js"
            ],
            "settings": {
                "foreground": "#5CDAFF"
            }
        }
    ]
}